import { useEffect, useState } from "react";
import "./App.css";
import AllData from "./Components/all-data";
import PdfPopUp from "./Components/PopUpPdf";
import ExcelPopUp from "./Components/PopupExcel";

function App() {
  const [data, setData] = useState({ results: [] });
  const [showPopUp, setShowPopUp] = useState(false);
  const [excPopUp, setExcPopUp] = useState(false);

  useEffect(() => {
    fetch("/data.json")
      .then((res) => res.json())
      .then((json) => setData(json))
      .catch((err) => console.log(err));
  }, []);

  return (
    <>
      <div className="grid grid-cols-[20%_55%_25%] bg-[#EDEB62] h-[100vh]">
        <div className="bg-sky-400 m-5 p-5 rounded-lg">
          <div className="flex justify-center align-center font-semibold text-xl bg-black rounded text-white capitalize py-3">
            Attendance
          </div>
        </div>

        <div className="bg-white my-5 p-5 rounded-lg overflow-y-scroll custom-scrollbar">
          <AllData data={data} />
        </div>

        <div className="bg-sky-400 m-5 p-5 rounded-lg">
          <div className="flex justify-center align-center font-semibold text-xl bg-black rounded text-white capitalize py-3 mb-10">
            Download Report
          </div>

          <div className="flex flex-col justify-center items-center gap-5">
            <button
              type="button"
              className="bg-[#EDEB62] p-3 rounded-lg flex w-full justify-center font-semibold"
              onClick={() => setShowPopUp(true)}
            >
              Report 1
            </button>
            <button
              type="button"
              className="bg-[#EDEB62] p-3 rounded-lg flex w-full justify-center font-semibold"
              onClick={() => setExcPopUp(true)}
            >
              Report 2
            </button>

            {showPopUp && <PdfPopUp closePopup={() => setShowPopUp(false)} />}
            {excPopUp && <ExcelPopUp closePopup={() => setExcPopUp(false)} />}
          </div>
        </div>
      </div>
    </>
  );
}

export default App;
